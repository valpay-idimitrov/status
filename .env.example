# Datadog (Organization Settings > API Keys / Application Keys)
DD_API_KEY=
DD_APP_KEY=
DD_SITE=datadoghq.com

# Supabase (Project Settings > API)
SUPABASE_URL=
# The SERVICE ROLE key, not the anon key — this bypasses RLS and must only
# ever be set as a Vercel environment variable, never exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret required in the "x-admin-token" header to post incidents
ADMIN_TOKEN=change-me-to-something-long-and-random
